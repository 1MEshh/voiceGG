# Maintainer: 1MEshh <https://github.com/1MEshh>
pkgname=voicegg-bin
pkgver=2.0.0
pkgrel=1
pkgdesc="The ultra-fast SteelSeries Sonar & SteelSeries GG alternative for Linux & PipeWire"
arch=('x86_64')
url="https://github.com/1MEshh/voiceGG"
license=('GPL-3.0-or-later')
depends=(
    'pipewire'
    'wireplumber'
    'webkit2gtk-4.1'
    'gtk3'
    'libayatana-appindicator'
)
optdepends=(
    'noise-suppression-for-voice: Neural AI background noise suppression'
    'swayosd: On-screen display for ChatMix and volume changes'
    'rofi: Fast keyboard preset switcher menu'
)
provides=('voicegg')
conflicts=('voicegg')

build() {
    # Building from source in PKGBUILD
    cd "${srcdir:-.}"
}

package() {
    install -d "${pkgdir}/usr/bin"
    install -d "${pkgdir}/usr/share/applications"
    install -d "${pkgdir}/usr/share/icons/hicolor/scalable/apps"
    install -d "${pkgdir}/usr/share/metainfo"
    install -d "${pkgdir}/usr/lib/systemd/user"

    # Binaries
    if [ -f "target/release/voicegg-daemon" ]; then
        install -m 755 "target/release/voicegg-daemon" "${pkgdir}/usr/bin/voicegg-daemon"
        install -m 755 "target/release/voicegg" "${pkgdir}/usr/bin/voicegg"
        install -m 755 "app/src-tauri/target/release/voicegg-gui" "${pkgdir}/usr/bin/voicegg-gui"
    fi

    # Desktop entry & metadata
    install -m 644 "packaging/voicegg.desktop" "${pkgdir}/usr/share/applications/com.voicegg.VoiceGG.desktop"
    install -m 644 "packaging/desktop/com.voicegg.VoiceGG.metainfo.xml" "${pkgdir}/usr/share/metainfo/com.voicegg.VoiceGG.metainfo.xml"
    install -m 644 "packaging/icons/voicegg.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/voicegg.svg"
    install -m 644 "packaging/systemd/voicegg-daemon.service" "${pkgdir}/usr/lib/systemd/user/voicegg-daemon.service"
}

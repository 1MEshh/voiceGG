[Unit]
Description=VoiceGG Audio Routing & DSP Daemon
Documentation=https://github.com/voicegg/voicegg
After=pipewire.service wireplumber.service
Requires=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/bin/voicegg-daemon
ExecStopPost=%h/.local/bin/voicegg panic
Restart=on-failure
RestartSec=2s
Nice=-11

# Security Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t/voicegg %h/.config/voicegg %h/.config/pulse %h/.local/state/wireplumber

[Install]
WantedBy=default.target
